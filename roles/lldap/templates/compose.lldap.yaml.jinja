---
services:
  lldap:
    container_name: lldap
    image: lldap/lldap:stable
    restart: unless-stopped
    networks:
      db:
      traefik:
    volumes:
      - "{{ data_dir }}/data:/data"
    environment:
      LLDAP_JWT_SECRET: "{{ lldap_jwt_secret }}"
      LLDAP_LDAP_BASE_DN: "{{ lldap_base_dn }}"
      LLDAP_LDAP_USER_PASS: "{{ lldap_admin_password }}"
      LLDAP_HTTP_URL: "https://ldap.{{ root_domain }}"
      TZ: "{{ timezone }}"
    labels:
      traefik.enable: 'true'
      traefik.http.services.lldap.loadbalancer.server.port: '17170'
      traefik.http.routers.lldap.rule: "Host(`ldap.{{ root_domain }}`)"
      traefik.http.routers.lldap.entrypoints: "web,websecure"
      traefik.http.routers.lldap.tls.certresolver: "cloudflareResolver"
      traefik.http.routers.lldap.middlewares: "force-https@file,authelia@file"

networks:
  traefik:
    name: "{{ traefik_webgateway }}"
    external: true
  db:
    name: "{{ docker_compose_project_name }}_db"
    external: true
